rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "clainyemblo@gmail.com" ||
        firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // --- Rules ---

    // Academic Resources (Course Materials)
    match /academic_resources/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Student Submissions
    match /submissions/{studentId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == studentId;
      allow delete: if isAdmin();
    }

    // General Submissions (Admin view)
    match /submissions/{allPaths=**} {
      allow read: if isAdmin();
    }

    // Student Documents (Admission letters, receipts, etc.)
    match /student_documents/{studentId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == studentId && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isSignedIn() && (request.auth.uid == studentId || isAdmin());
    }

    // Profile Images
    match /profile_images/{studentId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == studentId && request.resource.size < 5 * 1024 * 1024;
    }

    // Official School Documents (Templates, Prospectus, etc.)
    match /school_documents/{allPaths=**} {
      allow read: if isSignedIn();
      allow write, delete: if isAdmin();
    }
  }
}
